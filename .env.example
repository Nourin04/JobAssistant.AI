# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Groq API key for LLM inference
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# The URL of the deployed frontend (used for CORS on the backend).
# In local development this defaults to http://localhost:5173 if not set.
# In production, set this to your Vercel deployment URL on Render.
FRONTEND_URL=http://localhost:5173
